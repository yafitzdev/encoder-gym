# Repository allowlist
#
# Ignore every top-level path unless it is explicitly admitted below. This keeps
# local state and accidental root-level files out of Git by default.
/*

# Repository metadata and root configuration
!/.cargo/
!/.github/
!/.editorconfig
!/.env.example
!/.gitattributes
!/.gitignore
!/.mailmap
!/CHANGELOG.md
!/CODE_OF_CONDUCT.md
!/CONTRIBUTING.md
!/Cargo.lock
!/Cargo.toml
!/LICENSE
!/LICENSE.*
!/README.md
!/SECURITY.md
!/goal.md
!/rust-toolchain.toml
!/rustfmt.toml

# Version-controlled product surface
!/adapters/
!/apps/
!/crates/
!/demo/
!/docs/
!/ui/

# Internal planning and decision logs are intentionally not published
/docs/decisions/
/docs/roadmap/

# Root-level scratch, runtime, and implementation-owned directories stay local
/artifacts/
/data/
/examples/
/exports/
/migrations/

# Generated, private, and machine-local content inside allowlisted trees
target/
node_modules/
dist/
/coverage/
__pycache__/
.pytest_cache/
.idea/
.vscode/
.electron-cache/
.npm-cache/
qa/

.env
.env.*
!.env.example

*.log
*.py[cod]
*.swp
smoke-ok.txt
Thumbs.db
.DS_Store
